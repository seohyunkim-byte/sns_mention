# Streamlit Cloud 배포 시 이 파일을 참고해서
# 대시보드 → App settings → Secrets 메뉴에 동일한 형식으로 붙여넣으세요.
# 로컬 실행 시에는 이 파일을 `.streamlit/secrets.toml` 로 복사하면 자동 로드됩니다.
# (단, 실제 `secrets.toml` 은 `.gitignore` 됩니다.)

# Google Gemini API 키 — https://aistudio.google.com 에서 발급 (무료)
GEMINI_API_KEY = "your-google-ai-studio-key"

# 앱 비밀번호 — 팀이 공유하는 단일 패스워드. 빈 문자열이면 게이트 비활성.
APP_PASSWORD = "팀원들과만 공유할 비밀번호"

# 사용할 Gemini 모델 (선택) — 기본은 "gemini-2.5-flash-lite" (현재 무료 등급에서 호출 가능한
# 유일한 안정 옵션). "gemini-2.0-flash" 와 "gemini-2.5-flash" 는 현재 free tier 한도가 0 또는
# 매우 낮음. 더 좋은 품질이 필요하면 Google AI Studio 결제 후 "gemini-2.5-flash" 권장.
# GEMINI_MODEL = "gemini-2.5-flash-lite"

# Supabase (선택, 영구 저장소) — 둘 다 채우면 Supabase 사용. 비우면 로컬 JSON 파일.
# Streamlit Cloud 무료 티어는 파일 시스템이 휘발성이라 reboot 시 등록된 브랜드가 사라진다.
# 데이터를 영구 보관하려면 https://supabase.com 에서 무료 프로젝트 만들고 아래 두 값 채우기.
# 1) Project URL: 대시보드 → Settings → API → "Project URL"
# 2) anon public key: 대시보드 → Settings → API → "anon public" (절대 service_role 키 X)
# 또한 Supabase SQL Editor 에서 1회 실행 필요:
#   create table brand_profiles (
#     slug text primary key,
#     data jsonb not null,
#     updated_at timestamptz not null default now()
#   );
SUPABASE_URL = ""
SUPABASE_KEY = ""
