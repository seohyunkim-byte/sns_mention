# Streamlit Cloud 배포 시 이 파일을 참고해서
# 대시보드 → App settings → Secrets 메뉴에 동일한 형식으로 붙여넣으세요.
# 로컬 실행 시에는 이 파일을 `.streamlit/secrets.toml` 로 복사하면 자동 로드됩니다.
# (단, 실제 `secrets.toml` 은 `.gitignore` 됩니다.)

# Google Gemini API 키 — Gemini 2.5 Flash 호출용
# https://aistudio.google.com 에서 발급 가능 (무료 등급 포함)
GEMINI_API_KEY = "your-google-ai-studio-key"

# 앱 비밀번호 — 팀이 공유하는 단일 패스워드. 빈 문자열이면 게이트 비활성.
APP_PASSWORD = "팀원들과만 공유할 비밀번호"
